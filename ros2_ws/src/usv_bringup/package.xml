<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_bringup</name>
  <version>0.1.0</version>
  <description>Launches every GPS and IMU module of the test rig (config/rig.yaml) and a status check node.</description>
  <maintainer email="seanjohnson0807@gmail.com">Sean Johnson</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>
  <exec_depend>ublox_gps</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>icm20948_ros2</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
